{
  "name": "potentiamod-desktop",
  "description": "A TurboWarp mod with a compiler to run projects faster, dark mode for your eyes, a bunch of addons to improve the editor, and more.",
  "version": "1.3.0",
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0",
  "type": "commonjs",
  "author": {
    "name": "Crytal Franks",
    "email": "crystalfranks18@hotmail.com"
  },
  "scripts": {
    "fetch": "node scripts/download-library-files.mjs && node scripts/download-packager.mjs && node scripts/prepare-extensions.mjs",
    "webpack:compile": "webpack",
    "webpack:watch": "webpack --watch",
    "webpack:prod": "cross-env NODE_ENV=production webpack",
    "electron:start": "electron src-main/entrypoint.js",
    "electron:linux": "./electron_build_fix_until_reboot.sh; electron src-main/entrypoint.js",
    "electron:package:dir": "electron-builder --dir",
    "translations:upload": "node scripts/upload-translations.mjs",
    "translations:download": "node scripts/download-translations.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-react": "^7.13.13",
    "@electron/fuses": "^2.1.2",
    "@gaiamod/extensions": "github:GaiaWindWave90/gm-extensions#master",
    "@potentiamod/pot-extensions": "github:PotentiaMod/pot-extensions#master",
    "@transifex/api": "4.3.0",
    "@turbowarp/extensions": "github:TurboWarp/extensions#master",
    "autoprefixer": "^9.8.8",
    "babel-loader": "^8.4.1",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^1.0.1",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "file-loader": "^6.2.0",
    "monaco-editor-webpack-plugin": "^4.2.0",
    "postcss": "^8.4.13",
    "postcss-import": "^14.0.0",
    "postcss-loader": "^4.2.0",
    "postcss-simple-vars": "^6.0.3",
    "scratch-gui": "github:PotentiaMod/scratch-gui#develop",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#master",
    "style-loader": "^0.23.0",
    "url-loader": "^4.1.1",
    "webpack": "4.47.0",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron-winstaller",
      "scratch-gui",
      "scratch-l10n"
    ]
  },
  "homepage": "https://potentiamod.github.io/desktop.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/PotentiaMod/desktop.git"
  },
  "bugs": {
    "url": "https://github.com/PotentiaMod/desktop/issues",
    "email": "crystalfranks18@hotmail.com"
  },
  "main": "./src-main/entrypoint.js",
  "desktopName": "org.potentiamod.desktop",
  "build": {
    "appId": "org.potentiamod.desktop",
    "productName": "PotentiaMod",
    "files": [
      "node_modules/**/*",
      "src-main/**/*",
      "src-preload/**/*",
      "src-renderer/**/*",
      "dist-renderer-webpack/**/*",
      "dist-library-files/**/*",
      "dist-extensions/**/*"
    ],
    "extraResources": [
      {
        "from": "art/icon.png",
        "to": "icon.png"
      },
      {
        "from": "art/icon.svg",
        "to": "icon.svg"
      }
    ],
    "win": {
      "artifactName": "${productName}-Windows-${arch}-${version}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Windows-Installer-${arch}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Windows-Portable-${arch}-${version}.${ext}"
    },
    "appx": {
      "artifactName": "${productName}-Windows-Store-${arch}-${version}.${ext}",
      "applicationId": "PotentiaMod",
      "displayName": "PotentiaMod",
      "identityName": "GaiaWindWav90.PotentiaMod",
      "publisher": "CN=54F4F60F-5369-41E6-BB97-D1795FE27384",
      "publisherDisplayName": "GaiaWindWav90",
      "backgroundColor": "#4800CC",
      "showNameOnTiles": true
    },
    "mac": {
      "artifactName": "${productName}-MacOS-${arch}-${version}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSMultipleInstancesProhibited": true,
        "NSCameraUsageDescription": "This app requires camera access when using the video sensing or face sensing blocks.",
        "NSMicrophoneUsageDescription": "This app requires microphone access when recording sounds or detecting loudness."
      },
      "target": [
        {
          "arch": "universal",
          "target": "dmg"
        }
      ]
    },
    "linux": {
      "executableName": "potentiamod-desktop",
      "artifactName": "${productName}-Linux-Installer-${arch}-${version}.${ext}",
      "maintainer": "Crystal Franks <crystalfranks18@hotmail.com>",
      "icon": "./build/",
      "synopsis": "Mod of TurboWarp with tons of special features.",
      "description": "PotentiaMod is a TurboWarp mod with a compiler to run projects faster, dark mode for your eyes, a bunch of addons to improve the editor, and more.",
      "category": "Development",
      "desktop": {
        "entry": {
          "StartupWMClass": "potentiamod-desktop",
          "Keywords": "scratch; turbowarp;"
        }
      },
      "extraFiles": [
        "linux-files"
      ],
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "appimage"
        },
        {
          "target": "rpm"
        },
        {
          "target": "tar.gz"
        }
      ]
    },
    "appImage": {
      "license": null
    },
    "rpm": {
      "artifactName": "${productName}-Linux-Installer-${arch}-${version}.${ext}"
    },
    "fileAssociations": [
	{
        "ext": "pot",
        "name": "PotentiaMod Project",
        "description": "PotentiaMod Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.pot"
      },
	  {
        "ext": "cmp",
        "name": "CattyMod Project",
        "description": "CattyMod Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.cmp"
      },
	  {
        "ext": "mwp",
        "name": "MistWarp Project",
        "description": "MistWarp Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.mwp"
      },
	  {
